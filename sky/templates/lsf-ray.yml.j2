cluster_name: {{cluster_name_on_cloud}}

# The maximum number of workers nodes to launch in addition to the head node.
max_workers: {{num_nodes - 1}}
upscaling_speed: {{num_nodes - 1}}
idle_timeout_minutes: 60

provider:
  type: external
  module: sky.provision.lsf

  cluster: "{{lsf_cluster}}"
  queue: "{{lsf_queue}}"
  provision_timeout: {{provision_timeout}}
  # Enrolled into ~/.ssh/authorized_keys on the (shared) home at provision
  # time, so both the login node and the in-job sshd accept the SkyPilot
  # key. Substituted by sky.authentication.configure_ssh_info.
  public_key: skypilot:ssh_public_key_content

  ssh:
    hostname: {{ssh_hostname}}
    port: {{ssh_port}}
    user: {{ssh_user}}
{% if lsf_private_key is not none %}
    private_key: {{lsf_private_key}}
{% endif %}
{% if lsf_proxy_command is not none %}
    proxycommand: {{lsf_proxy_command | tojson }}
{% endif %}
{% if lsf_proxy_jump is not none %}
    proxyjump: {{lsf_proxy_jump | tojson }}
{% endif %}
    identities_only: {{lsf_identities_only}}

auth:
  ssh_user: {{ssh_user}}
  ssh_private_key: {{ssh_private_key}}

available_node_types:
  ray_head_default:
    resources: {}
    node_config:
      # From clouds/lsf.py::Lsf.make_deploy_resources_variables.
      instance_type: {{instance_type}}
      disk_size: {{disk_size}}
      cpus: {{cpus}}
      memory: {{memory}}
      accelerator_type: {{accelerator_type}}
      accelerator_count: {{accelerator_count}}
      walltime: {{walltime}}
{% if bsub_options is defined and bsub_options %}
      bsub_options: {{bsub_options | tojson}}
{% endif %}

head_node_type: ray_head_default

# Format: `REMOTE_PATH : LOCAL_PATH`
file_mounts: {
  "{{sky_ray_yaml_remote_path}}": "{{sky_ray_yaml_local_path}}",
  "{{sky_remote_path}}/{{sky_wheel_hash}}": "{{sky_local_path}}",
{%- for remote_path, local_path in credentials.items() %}
  "{{remote_path}}": "{{local_path}}",
{%- endfor %}
}

rsync_exclude: []

initialization_commands: []

# List of shell commands to run to set up nodes.
# NOTE: HPC users have no sudo; every command here must run unprivileged.
#
# Increment the following for catching performance bugs easier:
#   current num items (num SSH connections): 1
setup_commands:
  - |
    {%- for initial_setup_command in initial_setup_commands %}
    {{ initial_setup_command }}
    {%- endfor %}
    mkdir -p ~/.ssh; touch ~/.ssh/config;
    {{ conda_installation_commands }}
    {{ uv_installation_commands }}
    {{ ray_skypilot_installation_commands }}
    {{ copy_skypilot_templates_commands }}
    mkdir -p ~/.ssh; (grep -Pzo -q "Host \*\n  StrictHostKeyChecking no" ~/.ssh/config) || printf "Host *\n  StrictHostKeyChecking no\n" >> ~/.ssh/config;

# Command to start ray clusters are now placed in `sky.provision.instance_setup`.
# We do not need to list it here anymore.

head_node: {}
worker_nodes: {}

# These fields are required for external cloud providers.
head_setup_commands: []
worker_setup_commands: []
cluster_synced_files: []
file_mounts_sync_continuously: False
